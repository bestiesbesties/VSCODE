{
    "editor.fontFamily": "Arial",
    "editor.autoClosingBrackets": "never",
    "editor.autoClosingComments": "never",
    "editor.autoClosingQuotes": "never",
    "editor.fontSize": 16,
    "editor.parameterHints.enabled": true,
    "editor.lightbulb.enabled": "off",
    "editor.fontLigatures": false,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {"**/.git": false},
    "explorer.confirmDragAndDrop": false,
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "workbench.colorTheme": "Visual Studio Dark",
    "workbench.startupEditor": "none",
    "workbench.preferredHighContrastColorTheme": "Visual Studio Dark",
    "workbench.editor.enablePreview": false,
    "workbench.iconTheme": null,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "window.zoomLevel": 1,
    "window.commandCenter": false,
    "chat.commandCenter.enabled": false,
    "editor.cursorBlinking": "solid",
    "editor.cursorStyle": "line",
    "editor.showFoldingControls": "never",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.overviewRulerBorder": false,
    "editor.tabCompletion": "off",
    "terminal.integrated.fontFamily": "Melno",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "extensions.ignoreRecommendations": true,
    "editor.minimap.enabled": false,
    "python.defaultInterpreterPath": "/usr/local/bin/python3",
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.scrollback": 250,
    "terminal.integrated.stickyScroll.enabled": false,
    "editor.stickyScroll.enabled": true,
    "workbench.tree.enableStickyScroll": false,
    "workbench.tree.renderIndentGuides": "always",
    "python.createEnvironment.trigger": "off",

    "workbench.colorCustomizations": {
        "terminal.background": "#000000",
        "editor.background": "#000000",
        "sideBar.background": "#000000",
        "activityBar.background": "#000000",
        "titleBar.activeBackground": "#000000",
        "titleBar.inactiveBackground": "#000000",
        "focusBorder": "#ff0000",
        "editorGroup.border": "#fffb0080",
        "editor.lineHighlightBorder": "#fffb0060",
        "quickInput.background": "#000000",
        "quickInput.foreground": "#FFFFFF",
        "quickInputTitle.background": "#000000e0",
        "editorSuggestWidget.background": "#00000070",
        "editorSuggestWidget.foreground": "#FFFFFF",
        "editorSuggestWidget.border" :  "#ffffff00",
        "editorSuggestWidget.selectedBackground": "#fffb0070",
        "editorHoverWidget.background": "#00000070",
        "editorHoverWidget.border": "#ffffff00",
        "editorSignatureHelp.background": "#000000",
        "editorSignatureHelp.foreground": "#FFFFFF",
        "editorSignatureHelp.border": "#ffffff00",
    },
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "chat.checkpoints.enabled": false,
    "hediet.vscode-drawio.resizeImages": null,
}
